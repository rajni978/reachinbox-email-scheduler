# ==========================================
# ReachInbox Full-Stack Email Scheduler
# Environment Variables Configuration
# ==========================================

# Node & General Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reachinbox_scheduler
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Worker Concurrency & Safety
WORKER_CONCURRENCY=5
DEFAULT_JOB_ATTEMPTS=3
DEFAULT_BACKOFF_DELAY_MS=5000

# Rate Limiting & Spacing Defaults
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Session & Encryption Keys
SESSION_SECRET=a_very_secret_key_with_at_least_32_characters_long_for_cookies
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
AUTH_BYPASS_DEV=true

# Slack App OAuth & Webhook Integration
# Obtain from Slack API Dashboard (api.slack.com/apps)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Elasticsearch Service
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Logging
LOG_LEVEL=info
